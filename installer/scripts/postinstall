#!/bin/bash
# 天微多开 安装包 postinstall
# 安装完成后的收尾：
#   1) 删除旧命名 TianYanWeChat.app（覆盖升级场景残留的旧英文目录）
#   2) 注销旧路径的 LaunchServices 注册，注册新路径，刷新图标缓存
# postinstall 运行环境：$2=目标卷  $3=目标根路径

set -u

NEW_APP_NAME="天微多开.app"
OLD_APP_NAME="TianYanWeChat.app"
BASE_VOL="${2:-/}"
BASE_ROOT="${3:-/}"

# 定位新安装的应用
APP_PATH=""
if [ "$BASE_ROOT" = "/" ]; then
  APP_PATH="${BASE_VOL}/Applications/${NEW_APP_NAME}"
else
  APP_PATH="${BASE_VOL}${BASE_ROOT}/Applications/${NEW_APP_NAME}"
fi

# 旧命名目录（若仍存在则删除）
OLD_PATH=""
if [ "$BASE_ROOT" = "/" ]; then
  OLD_PATH="${BASE_VOL}/Applications/${OLD_APP_NAME}"
else
  OLD_PATH="${BASE_VOL}${BASE_ROOT}/Applications/${OLD_APP_NAME}"
fi

if [ -n "$OLD_PATH" ] && [ "$OLD_PATH" != "$APP_PATH" ] && [ -d "$OLD_PATH" ]; then
  echo "清理旧命名应用: ${OLD_PATH}"
  rm -rf "$OLD_PATH" 2>/dev/null || true
fi

if [ -d "$APP_PATH" ]; then
  # 确保可执行权限
  chmod +x "$APP_PATH/Contents/MacOS/TianYanWeChat" 2>/dev/null || true

  # --- 刷新 LaunchServices 应用注册与图标缓存 ---
  # 覆盖安装旧版本时，macOS 的图标缓存（com.apple.iconservices）可能仍显示旧图标
  # 或默认图标。这里显式注销旧路径/新路径并重新注册本应用，触发系统重建图标索引。
  LsRegister="/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister"
  if [ -x "$LsRegister" ]; then
    if [ -n "$OLD_PATH" ]; then
      "$LsRegister" -u "$OLD_PATH" >/dev/null 2>&1 || true
    fi
    "$LsRegister" -u "$APP_PATH" >/dev/null 2>&1 || true
    "$LsRegister" -f "$APP_PATH" >/dev/null 2>&1 || true
  fi
  # touch 应用包，更新 mtime 以提示系统重新扫描
  touch "$APP_PATH" 2>/dev/null || true
fi

echo "天微多开已安装到 ${APP_PATH}"
exit 0